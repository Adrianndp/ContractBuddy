# The one config file for the whole project: copy to .env (git-ignored) and adjust.
# Read by docker compose, the backend (also when run with uvicorn on the host) and Vite (VITE_* only).

# NVIDIA GPU for Ollama (needs the NVIDIA Container Toolkit, see docker-compose.gpu.yml).
# Leave commented out to run on CPU.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Backend URL the browser calls, baked into the frontend at build time (rebuild after changing).
VITE_API_URL=http://localhost:8000

# Postgres from docker-compose.yml (host port 5433, because 5432 is often taken by a local Postgres).
# For uvicorn on the host; Compose overrides it for the backend container (db:5432).
DATABASE_URL=postgresql+asyncpg://manualbuddy:manualbuddy@localhost:5433/manualbuddy

# Ollama on the host, for uvicorn on the host; Compose overrides it for the backend container (http://ollama:11434).
# The models are also what ollama-init pulls into the Compose Ollama.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Must match EMBEDDING_MODEL. Changing model/dimension = drop tables + re-upload documents.
EMBEDDING_DIM=1024
CHAT_MODEL=llama3.2:3b

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
